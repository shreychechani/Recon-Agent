# Copy to .env and fill in. NEVER commit .env.
# The pipeline runs fully without a key (schema mapping + adjudication fall back
# to deterministic behaviour); the key only enables the two LLM touchpoints.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for schema mapping and adjudication.
RECON_LLM_MODEL=claude-sonnet-4-6

# Optional: hard-disable all LLM calls even if a key is present (useful for CI
# and for reproducing the zero-LLM deterministic baseline).
RECON_DISABLE_LLM=0
